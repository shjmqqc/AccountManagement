<ui:FluentWindow x:Class="AccountManagement.Views.TagManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="标签管理" Width="760" Height="560" MinWidth="650" MinHeight="480"
 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" FontFamily="Microsoft YaHei UI">
 <Grid Background="#F7F9FC"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ui:TitleBar Title="标签管理"/>
  <Grid x:Name="Fields" Grid.Row="1" Margin="24,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,14"><TextBlock Text="我的标签" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="修改会同步到使用此标签的所有帐号；删除标签不会删除帐号或分享授权。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
   <ListBox x:Name="TagList" Grid.Row="1" SelectionChanged="Selection_Changed" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Grid Margin="3,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{Binding Background}" Padding="8,5" CornerRadius="5" HorizontalAlignment="Left"><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" TextWrapping="Wrap" MaxWidth="380"/></Border><TextBlock Grid.Column="1" Text="{Binding AccountCount, StringFormat=使用于 {0} 个帐号}" VerticalAlignment="Center" Margin="10,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:TextBox x:Name="NameBox" PlaceholderText="选择标签后修改名称" MaxLength="80"/><ComboBox x:Name="ColorPicker" Grid.Column="1" Margin="8,0" SelectedValuePath="Color"><ComboBox.ItemTemplate><DataTemplate><Border Background="{Binding Background}" Padding="8,3" CornerRadius="4"><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}"/></Border></DataTemplate></ComboBox.ItemTemplate></ComboBox><ui:Button Grid.Column="2" Content="保存修改" Click="Save_Click" Appearance="Primary" Background="#0067C0" Foreground="White"/></Grid>
  </Grid>
  <StackPanel Grid.Row="2" Margin="24,0,24,20"><TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><ui:Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click"/><ui:Button x:Name="DeleteButton" Content="删除所选标签…" Click="Delete_Click" Margin="8,0"/><ui:Button x:Name="CloseButton" Content="关闭" Click="Close_Click"/></StackPanel></StackPanel>
 </Grid>
</ui:FluentWindow>
