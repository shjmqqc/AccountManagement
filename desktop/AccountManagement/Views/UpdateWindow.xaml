<ui:FluentWindow x:Class="AccountManagement.Views.UpdateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="应用更新" Width="590" Height="550" MinWidth="520" MinHeight="480"
 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" FontFamily="Microsoft YaHei UI">
 <Grid Background="#F7F9FC"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="应用更新"/>
  <Grid Grid.Row="1" Margin="26,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="{Binding CurrentVersion, StringFormat=当前版本：{0}}" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Grid.Row="1" Text="{Binding Source}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6"/>
   <TextBlock Grid.Row="2" Text="下载后验证发布签名，确认后重启安装。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
   <TextBox Grid.Row="3" Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12"/>
   <ProgressBar Grid.Row="4" Value="{Binding Progress}" Maximum="100" Height="8" Margin="0,18,0,10"/>
   <TextBlock Grid.Row="5" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
  </Grid>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="20,0,20,20">
   <ui:Button Content="检查更新" Click="Check_Click" IsEnabled="{Binding CanCheck}" Margin="0,0,8,0"/>
   <ui:Button Content="下载更新" Click="Download_Click" IsEnabled="{Binding CanDownload}" Margin="0,0,8,0"/>
   <ui:Button Content="取消下载" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" Margin="0,0,8,0"/>
   <ui:Button Content="重启并更新" Click="Restart_Click" IsEnabled="{Binding CanRestart}" Background="#0067C0" Foreground="White"/>
  </WrapPanel>
 </Grid>
</ui:FluentWindow>
