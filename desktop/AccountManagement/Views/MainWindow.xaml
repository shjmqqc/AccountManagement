<ui:FluentWindow x:Class="AccountManagement.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="帐号管理" Width="1320" Height="820" MinWidth="1060" MinHeight="660"
 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" FontFamily="Microsoft YaHei UI"
 Background="#F4F7FB" UseLayoutRounding="True">
 <Grid x:Name="LayoutRoot" Background="#F4F7FB">
  <Grid.Resources>
   <Style x:Key="TableText" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   </Style>
   <Style x:Key="RowAction" TargetType="Button">
    <Setter Property="Foreground" Value="#1765A6"/><Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="5,2"/><Setter Property="Height" Value="26"/><Setter Property="MinWidth" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DCEAFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DCEAFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="ListSubtitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers>
   </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="72"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <ui:TitleBar Title="帐号管理"/>
  <Grid Grid.Row="1" Margin="26,12,26,18" IsEnabled="{Binding IsIdle}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding LibraryTitle}" ToolTip="{Binding LibraryTitle}" TextTrimming="CharacterEllipsis" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding LibrarySubtitle}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
   <Grid Grid.Column="1" Margin="14,6,26,4">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ui:TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索平台、帐号名称、登录帐号或备注" MaxLength="200" VerticalAlignment="Center" AutomationProperties.Name="搜索全部帐号">
     <ui:TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></ui:TextBox.InputBindings>
    </ui:TextBox>
    <ui:Button x:Name="SearchButton" Grid.Column="1" Content="搜索" Command="{Binding SearchCommand}" Appearance="Primary" Background="#0067C0" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
   </Grid>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <ui:Button Content="返回本人数据" Click="ReturnOwn_Click" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0"/>
    <ui:Button x:Name="AdminButton" Content="管理" Click="Admin_Click" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0"/>
    <TextBlock Text="{Binding Identity}" ToolTip="{Binding Identity}" MaxWidth="150" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <ui:Button Content="帐户 ▾" Click="UserMenu_Click">
     <ui:Button.ContextMenu><ContextMenu><MenuItem Header="{Binding Updates.MenuText, Source={x:Static Application.Current}, FallbackValue=检查更新}" Click="Update_Click"/><Separator/><MenuItem Header="修改登录密码" Click="ChangePassword_Click"/><Separator/><MenuItem Header="退出登录" Click="Logout_Click"/></ContextMenu></ui:Button.ContextMenu>
    </ui:Button>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="20,0,20,0" IsEnabled="{Binding IsIdle}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="180" MinWidth="165"/><ColumnDefinition Width="8"/><ColumnDefinition x:Name="AccountColumn" Width="*" MinWidth="400"/><ColumnDefinition x:Name="DetailGap" Width="8"/><ColumnDefinition x:Name="DetailColumn" Width="300" MinWidth="280"/></Grid.ColumnDefinitions>
   <Border Background="#EAF0F8" CornerRadius="12" Padding="12,18,12,12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <StackPanel Margin="0,0,0,8"><ui:Button Content="我的帐号" Click="ReturnOwn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,5"/><ui:Button Content="分享给我" Click="Shared_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,5"/><ui:Button Content="分享给别人" Click="Outgoing_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6"/></StackPanel>
      <TextBlock Text="按标签筛选" Style="{StaticResource FieldLabel}"/>
      <ComboBox ItemsSource="{Binding TagChoices}" SelectedItem="{Binding SelectedTag}" DisplayMemberPath="Name" Margin="0,0,0,16"/>
      <DockPanel Margin="8,0"><ui:Button DockPanel.Dock="Right" Content="＋" ToolTip="新增平台" Click="AddPlatform_Click" Padding="9,3" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="平台" Style="{StaticResource PanelHeading}" VerticalAlignment="Center"/></DockPanel>
     </StackPanel>
     <ListBox x:Name="PlatformList" Grid.Row="2" ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}" SelectionChanged="Platform_SelectionChanged" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="平台列表">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="3,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding AccountCount}" Style="{StaticResource ListSubtitle}" Margin="6,0,2,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,12,0,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}"><ui:Button Content="编辑平台" Click="EditPlatform_Click" Padding="9,6"/><ui:Button Content="删除" Click="DeletePlatform_Click" Margin="6,0,0,0" Padding="9,6"/></StackPanel>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
   <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,10,8,6">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
     <DockPanel><ui:Button x:Name="ToggleDetailsButton" DockPanel.Dock="Right" Content="收起详情" Click="ToggleDetails_Click" Padding="8,5" Margin="6,0,0,0"/><ui:Button DockPanel.Dock="Right" Content="＋ 新增" Click="AddAccount_Click" Padding="10,5" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding ListTitle}" ToolTip="{Binding ListTitle}" Margin="5,0,6,0" Style="{StaticResource PanelHeading}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
     <DataGrid x:Name="AccountList" Grid.Row="2" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="32" FontSize="12" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="#FAFCFE" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="帐号列表">
      <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F6FB"/><Setter Property="Foreground" Value="#344E68"/><Setter Property="Padding" Value="8,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="BorderBrush" Value="#E2E8F0"/></Style></DataGrid.ColumnHeaderStyle>
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#20364C"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow"><Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True"><DataGridCellsPresenter SnapsToDevicePixels="True"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E1EFFF"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
      <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#20364C"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.CellStyle>
      <DataGrid.Columns>
       <DataGridTextColumn Header="帐号名称" Binding="{Binding DisplayName}" Width="1.2*" MinWidth="115" ElementStyle="{StaticResource TableText}"/>
       <DataGridTextColumn Header="登录帐号" Binding="{Binding Login}" Width="1.3*" MinWidth="125" ElementStyle="{StaticResource TableText}"/>
       <DataGridTextColumn Header="平台 / 分享人" Binding="{Binding PlatformDisplay}" Width="*" MinWidth="100" ElementStyle="{StaticResource TableText}"/>
       <DataGridTemplateColumn Header="标签" Width="145" MinWidth="145" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="{Binding TagsSummary}"><ItemsControl ItemsSource="{Binding CompactTags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding Background}" CornerRadius="4" Padding="5,2" Margin="0,0,4,0"><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" MaxWidth="44" TextTrimming="CharacterEllipsis" FontSize="11"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding ExtraTags}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="操作" Width="142" MinWidth="142" CanUserSort="False" CanUserResize="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0"><Button Content="复制帐号" Style="{StaticResource RowAction}" Click="CopyRowLogin_Click"/><Button Content="复制密码" Style="{StaticResource RowAction}" Click="CopyRowPassword_Click"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="2" Text="暂无帐号&#10;请刷新或调整搜索条件" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
   </Border>
   <GridSplitter x:Name="DetailSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Center" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
   <Border x:Name="DetailPanel" Grid.Column="4" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,18">
    <Grid>
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="选择一个帐号" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="查看登录信息、备注和密码" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/></StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
      <StackPanel>
       <DockPanel><ui:Button x:Name="EditAccountButton" DockPanel.Dock="Right" Content="编辑" Click="EditAccount_Click" Margin="12,0,0,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding SelectedAccount.DisplayName}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
       <TextBlock Text="{Binding DetailPlatform}" Foreground="#3269A5" Margin="0,8,0,14"/>
       <TextBlock Text="{Binding SelectedAccount.OwnerUsername, StringFormat=分享人：{0}}" Visibility="{Binding ShowingShared, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
       <ItemsControl ItemsSource="{Binding SelectedAccount.Tags}" ItemTemplate="{StaticResource TagBadge}" ItemsPanel="{StaticResource TagWrap}"/>
       <ui:Button Content="分享管理" Click="Share_Click" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
       <TextBlock Text="平台网址" Style="{StaticResource FieldLabel}"/>
       <DockPanel><ui:Button DockPanel.Dock="Right" Content="打开" Click="OpenUrl_Click" Padding="10,4" Margin="8,0,0,0"/><TextBlock Text="{Binding DetailUrl}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailUrl}" VerticalAlignment="Center"/></DockPanel>
       <TextBlock Text="登录帐号" Style="{StaticResource FieldLabel}"/>
       <DockPanel><ui:Button DockPanel.Dock="Right" Content="复制" Click="CopyLogin_Click" Padding="10,4" Margin="8,0,0,0"/><TextBlock Text="{Binding SelectedAccount.Login}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
       <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
       <Border Background="#F1F5FA" CornerRadius="8" Padding="12">
        <StackPanel><TextBlock Text="{Binding PasswordDisplay}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="16" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><ui:Button Content="{Binding RevealLabel}" Command="{Binding RevealPasswordCommand}" Padding="10,4"/><ui:Button Content="复制密码" Click="CopyPassword_Click" Padding="10,4" Margin="8,0,0,0"/></StackPanel></StackPanel>
       </Border>
       <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/>
       <TextBlock Text="{Binding SelectedAccount.Notes}" TextWrapping="Wrap" MinHeight="55" LineHeight="23"/>
       <Separator Margin="0,22,0,12" Background="#E7ECF3"/>
       <TextBlock Text="{Binding SelectedAccount.UpdatedText, StringFormat=更新时间：{0}}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
       <ui:Button x:Name="DeleteAccountButton" Content="删除帐号" Click="DeleteAccount_Click" Margin="0,18,0,0" Foreground="#A33838" HorizontalAlignment="Left" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="26,0"><ui:Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" Padding="10,2" Margin="8,4,0,4"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
 </Grid>
</ui:FluentWindow>
