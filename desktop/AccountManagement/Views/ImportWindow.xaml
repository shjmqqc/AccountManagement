<ui:FluentWindow x:Class="AccountManagement.Views.ImportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Excel 批量导入" Width="1040" Height="700" MinWidth="800" MinHeight="560"
 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" FontFamily="Microsoft YaHei UI">
 <Grid Background="#F7F9FC"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="Excel 批量导入"/>
  <StackPanel Grid.Row="1" Margin="24,12,24,16"><TextBlock Text="预览、确认，再导入" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="仅导入本人帐号库。重复帐号跳过，不修改原密码或标签；密码不会显示在预览中。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
   <StackPanel x:Name="FileActions" Orientation="Horizontal"><ui:Button Content="下载 Excel 模板" Click="Template_Click"/><ui:Button Content="选择 Excel 文件…" Click="Choose_Click" Margin="8,0,0,0"/></StackPanel>
   <TextBlock x:Name="FileLabel" Text="只支持 .xlsx，最多 1000 行、10 MB。标签用中文分号分隔。" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/>
  </StackPanel>
  <DataGrid x:Name="Preview" Grid.Row="2" Margin="24,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="34" EnableRowVirtualization="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E7EDF5" AlternatingRowBackground="#F5F8FC" ScrollViewer.HorizontalScrollBarVisibility="Auto">
   <DataGrid.Resources><Style x:Key="ImportText" TargetType="TextBlock"><Setter Property="Margin" Value="8,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style></DataGrid.Resources>
   <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="8,8"/><Setter Property="Background" Value="#EAF0F8"/><Setter Property="Foreground" Value="#344E68"/></Style></DataGrid.ColumnHeaderStyle>
   <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.CellStyle>
   <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow"><Border Background="{TemplateBinding Background}"><DataGridCellsPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E1EFFF"/><Setter Property="Foreground" Value="#20364C"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
   <DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ImportText}" Header="行号" Binding="{Binding RowNumber}" Width="48" MinWidth="48"/><DataGridTextColumn ElementStyle="{StaticResource ImportText}" Header="平台" Binding="{Binding Platform}" Width="120" MinWidth="120"/><DataGridTextColumn ElementStyle="{StaticResource ImportText}" Header="帐号名称" Binding="{Binding Name}" Width="120" MinWidth="120"/><DataGridTextColumn ElementStyle="{StaticResource ImportText}" Header="登录帐号" Binding="{Binding Login}" Width="145" MinWidth="145"/><DataGridTextColumn ElementStyle="{StaticResource ImportText}" Header="密码" Binding="{Binding PasswordSummary}" Width="65" MinWidth="65"/><DataGridTextColumn ElementStyle="{StaticResource ImportText}" Header="标签" Binding="{Binding Tags}" Width="110" MinWidth="110"/><DataGridTextColumn ElementStyle="{StaticResource ImportText}" Header="结果" Binding="{Binding State}" Width="85" MinWidth="85"/><DataGridTextColumn ElementStyle="{StaticResource ImportText}" Header="说明" Binding="{Binding Detail}" Width="*" MinWidth="190"/><DataGridTextColumn ElementStyle="{StaticResource ImportText}" Header="平台地址" Binding="{Binding Url}" Width="180" MinWidth="180"/><DataGridTextColumn ElementStyle="{StaticResource ImportText}" Header="备注" Binding="{Binding Notes}" Width="180" MinWidth="180"/></DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="24,16,24,20"><TextBlock x:Name="Notice" Text="下载模板，填写后选择文件。校验失败行不会提交，重复判断以服务器结果为准。" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource MutedBrush}"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ui:Button x:Name="SubmitButton" Content="确认导入…" IsEnabled="False" Click="Submit_Click" Appearance="Primary" Background="#0067C0" Foreground="White"/><ui:Button x:Name="StopButton" Content="停止后续导入" Visibility="Collapsed" Click="Stop_Click" Margin="8,0,0,0"/><ui:Button x:Name="CloseButton" Content="关闭" Click="Close_Click" Margin="8,0,0,0"/></StackPanel>
  </StackPanel>
 </Grid>
</ui:FluentWindow>
