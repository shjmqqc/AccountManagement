<ui:FluentWindow x:Class="AccountManagement.Views.AdminWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="管理中心" Width="960" Height="680" MinWidth="800" MinHeight="580"
 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" FontFamily="Microsoft YaHei UI">
 <Grid Background="#F4F7FB">
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="管理中心"/>
  <StackPanel Grid.Row="1" Margin="26,18,26,18"><TextBlock Text="管理中心" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="邀请同事加入，管理使用权限；他人的帐号库仅供查看。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
  <TabControl x:Name="Tabs" Grid.Row="2" Margin="22,0" IsEnabled="{Binding IsIdle}" Background="White">
   <TabItem Header="用户管理">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="选择用户后，可查看数据、停用或重置登录密码。管理员帐号不能停用或重置。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
     <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
      <Grid Margin="12,0,24,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text="用户名"/><TextBlock Grid.Column="1" Text="角色"/><TextBlock Grid.Column="2" Text="状态"/><TextBlock Grid.Column="3" Text="帐号数"/></Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" HorizontalContentAlignment="Stretch" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Username}" ToolTip="{Binding Username}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding RoleText}"/><TextBlock Grid.Column="2" Text="{Binding StateText}"/><TextBlock Grid.Column="3" Text="{Binding AccountCount}"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
      <ui:Button Content="查看帐号库 →" Click="View_Click" IsEnabled="{Binding CanViewUser}" Appearance="Primary" Background="#0067C0" Foreground="White"/>
      <ui:Button Content="{Binding ToggleLabel}" Click="Toggle_Click" IsEnabled="{Binding CanManageUser}" Margin="10,0,0,0"/>
      <ui:Button Content="重置登录密码" Click="Reset_Click" IsEnabled="{Binding CanManageUser}" Margin="10,0,0,0"/>
     </StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="邀请管理">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="邀请码 7 天有效、仅能使用一次。创建后立即复制并发给同事，关闭后无法再次查看。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
     <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
      <Grid Margin="12,0,24,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="创建时间"/><TextBlock Grid.Column="1" Text="到期时间"/><TextBlock Grid.Column="2" Text="状态"/><TextBlock Grid.Column="3" Text="邀请编号"/></Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding Invitations}" SelectedItem="{Binding SelectedInvitation}" HorizontalContentAlignment="Stretch" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,14"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding CreatedText}"/><TextBlock Grid.Column="1" Text="{Binding ExpiresText}"/><TextBlock Grid.Column="2" Text="{Binding StateText}"/><TextBlock Grid.Column="3" Text="{Binding Id}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <DockPanel Grid.Row="2" Margin="0,16,0,0"><ui:Button DockPanel.Dock="Right" Content="加载更多" Command="{Binding MoreInvitesCommand}"/><StackPanel Orientation="Horizontal"><ui:Button Content="创建邀请" Appearance="Primary" Background="#0067C0" Foreground="White" Command="{Binding CreateInviteCommand}"/><ui:Button Content="撤销所选邀请" Click="Revoke_Click" IsEnabled="{Binding CanRevoke}" Margin="10,0,0,0"/></StackPanel></DockPanel>
    </Grid>
   </TabItem>
  </TabControl>
  <DockPanel Grid.Row="3" Margin="26,16"><ui:Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/></DockPanel>
 </Grid>
</ui:FluentWindow>
